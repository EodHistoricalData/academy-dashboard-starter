# Copy this file to .env.local and add your key. Get a free key at https://eodhd.com
# NEVER commit your real key. .env.local is gitignored, and a pre-commit guard
# (scripts/precommit-key-guard.sh) blocks key-shaped strings from being committed.
EODHD_API_KEY=your_key_here

# Optional: override the API base (default https://eodhd.com/api)
# EODHD_API_BASE_URL=https://eodhd.com/api
