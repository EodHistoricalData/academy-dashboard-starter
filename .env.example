# Copy this file to .env.local and add your key. Get a free key at https://eodhd.com
# NEVER commit your real key. .env.local is gitignored, and a pre-commit guard
# (scripts/precommit-key-guard.sh) blocks key-shaped strings from being committed.
# The server refuses to start without a key unless EODHD_MOCK=1.
EODHD_API_KEY=your_key_here

# 1 = serve recorded fixtures and spend no API calls. Leave empty for live data.
EODHD_MOCK=

# Optional: override the API base (default https://eodhd.com/api)
# EODHD_API_BASE_URL=https://eodhd.com/api

# Sign-in for the dashboard and its saved documents. Empty password: in mock mode
# user 1 is assumed; with live data set both before you deploy.
DASHBOARD_PASSWORD=
# Signs the session cookie. Any long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Where the dashboard keeps saved screens, the shortlist and notes (gitignored).
STORE_FILE=.data/app.db
